---
import { Card as ShadcnCard } from './ui/card'
import { Badge } from './ui/badge'

interface Props {
  as?: keyof HTMLElementTagNameMap | 'a'
  class?: string
  href?: string
  heading: string
  subheading?: string
  imagePath?: string
  altText: string
  tags?: string[]
  repository?: string
}

const {
  as: Tag = 'div',
  class: className = '',
  href,
  heading,
  subheading,
  imagePath,
  altText,
  tags = [],
  repository,
} = Astro.props

const Wrapper = href ? 'a' : Tag
---

<Wrapper
  href={href}
  target={href ? '_blank' : undefined}
  rel={href ? 'noopener noreferrer' : undefined}
  class={`block ${className}`}
  data-project-card
  data-tags={tags.join(',')}
>
  <ShadcnCard
    className={`group relative flex h-full flex-none transform flex-col justify-start overflow-hidden shadow-lg transition duration-200 ease-in-out ${href ? 'cursor-pointer hover:border-primary' : ''}`}
  >
    {
      imagePath ? (
        <img
          src={imagePath}
          alt={altText}
          class="h-48 w-full rounded-2xl rounded-bl-none rounded-br-none object-cover transition duration-300 group-hover:scale-[1.02]"
          loading="lazy"
        />
      ) : (
        <div class="flex h-48 w-full items-center justify-center bg-linear-to-br from-orange-500/20 via-background to-orange-700/10">
          <span class="text-3xl font-black tracking-tight text-primary/70">
            {heading.slice(0, 2).toUpperCase()}
          </span>
        </div>
      )
    }
    <div class="flex flex-1 flex-col gap-3 px-5 py-4">
      <div class="flex flex-col gap-y-0.5">
        <h3 class="text-lg font-medium">{heading}</h3>
        {
          subheading && (
            <p class="line-clamp-2 text-sm text-muted-foreground">{subheading}</p>
          )
        }
      </div>
      {
        tags.length > 0 && (
          <div class="mt-auto flex flex-wrap gap-1.5">
            {tags.map((tag) => (
              <Badge variant="secondary" className="font-medium">
                {tag}
              </Badge>
            ))}
          </div>
        )
      }
      {
        repository && (
          <span class="text-xs text-muted-foreground underline-offset-2 group-hover:underline">
            Repo available
          </span>
        )
      }
    </div>
    <slot />
  </ShadcnCard>
</Wrapper>
