---
import Card from '../Card.astro'
import { Button } from '../ui/button'
import { ContactForm } from '../ui/ContactForm'
import { LINKS } from '../../lib/constants'
import { Calendar, MapPin } from 'lucide-react'

const EMAIL = 'bhelms@redmontdigital.com'
const MAILTO = `mailto:${EMAIL}?subject=${encodeURIComponent("Saw your portfolio — let's talk")}`
---

<Card colSpan="md:col-span-1" rowSpan="md:row-span-4">
  <div class="flex h-full flex-col gap-4">
    <header>
      <h2 class="font-display text-2xl font-semibold text-foreground">
        Let's work together
      </h2>
      <p class="mt-1 text-sm text-muted-foreground">
        Hiring, building, or just want to talk product? The fastest way to reach
        me is below.
      </p>
    </header>

    <!-- Primary CTA: booking is the lowest-friction path to a real conversation -->
    <a href={LINKS.booking} target="_blank" rel="noopener" class="block">
      <Button className="h-11 w-full text-base">
        <Calendar size={18} />
        Book a 15-min intro call
      </Button>
    </a>

    <div class="flex items-center gap-3">
      <div class="h-px flex-1 bg-border"></div>
      <span class="text-xs uppercase tracking-wide text-muted-foreground"
        >or send a message</span
      >
      <div class="h-px flex-1 bg-border"></div>
    </div>

    <ContactForm client:load email={EMAIL} />

    <div class="mt-auto flex flex-col gap-2 pt-2 text-sm">
      <a
        href={MAILTO}
        class="font-medium text-primary underline-offset-4 hover:underline"
        >{EMAIL}</a
      >
      <p class="flex items-center gap-1.5 text-muted-foreground">
        <MapPin size={14} /> Fairhope, Alabama
      </p>
      <ul class="mt-1 flex gap-4 text-muted-foreground">
        <li>
          <a
            class="underline-offset-4 hover:text-foreground hover:underline"
            href={LINKS.linkedin}
            target="_blank"
            rel="noopener">LinkedIn</a
          >
        </li>
        <li>
          <a
            class="underline-offset-4 hover:text-foreground hover:underline"
            href={LINKS.github}
            target="_blank"
            rel="noopener">GitHub</a
          >
        </li>
        <li>
          <a
            class="underline-offset-4 hover:text-foreground hover:underline"
            href={LINKS.instagram}
            target="_blank"
            rel="noopener">Instagram</a
          >
        </li>
      </ul>
    </div>
  </div>
</Card>
