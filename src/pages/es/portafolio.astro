---
import BaseLayout from '../../layouts/BaseLayout.astro'
import TopLayout from '../../layouts/TopLayout.astro'
import BottomLayout from '../../layouts/BottomLayout.astro'
import { PortfolioFilter } from '../../components/PortfolioFilter'
import { getLangFromUrl, useTranslations } from '../../i18n/utils'
import { collectProjectTags, getProjects } from '../../lib/projects'
import { fade } from 'astro:transitions'

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)
const projects = await getProjects()
const tags = collectProjectTags(projects)
---

<BaseLayout
  title={t('portfolio.title')}
  description={t('portfolio.description')}
>
  <main class="flex min-h-[80vh] flex-auto flex-col" transition:animate={fade()}>
    <TopLayout>
      <h2
        class="scroll-m-20 border-b pb-2 text-3xl font-semibold tracking-tight first:mt-0"
      >
        {t('portfolio.heading')}
      </h2>
      <p class="mt-3 max-w-2xl text-sm text-muted-foreground">
        {t('portfolio.description')}
      </p>
    </TopLayout>
    <BottomLayout size="xl">
      <PortfolioFilter
        client:load
        projects={projects}
        tags={tags}
        labels={{
          all: t('portfolio.filter.all'),
          empty: t('portfolio.filter.empty'),
          results: t('portfolio.filter.results'),
          repo: t('portfolio.repo'),
        }}
      />
    </BottomLayout>
  </main>
</BaseLayout>
